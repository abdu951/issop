generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}




model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String
  reports   Report[]
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  location    String
  status      String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}
