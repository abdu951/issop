generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("CITIZEN")
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  location    String
  status      String   @default("SUBMITTED")
  userId      String
  createdAt   DateTime @default(now())
}